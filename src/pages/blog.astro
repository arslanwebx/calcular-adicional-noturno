---
import BaseLayout from "../layouts/BaseLayout.astro";
import { lucasAlmeida } from "../config/authors";

const title = "Blog sobre Adicional Noturno";
const description =
  "Guias práticos para entender o cálculo do adicional noturno, a hora reduzida e a conferência do holerite.";
---

<BaseLayout title={title} description={description} canonicalPath="/blog/" breadcrumbs={[{ name: "Início", path: "/" }, { name: "Blog", path: "/blog/" }]}>
  <section class="page-hero blog-hero">
    <div class="reading-width">
      <h1>Blog</h1>
      <p>Guias claros para entender o adicional noturno e conferir os valores da jornada.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container blog-grid">
      <article class="blog-card">
        <a class="blog-card-image" href="/blog/como-calcular-adicional-noturno/" tabindex="-1" aria-hidden="true">
          <img
            src="/como-calcular-adicional-noturno.svg"
            width="1200"
            height="630"
            alt=""
          />
        </a>
        <div class="blog-card-content">
          <p class="article-meta">Atualizado em <time datetime="2026-07-17">17 de julho de 2026</time> · Por <a href={lucasAlmeida.href}>{lucasAlmeida.name}</a></p>
          <h2><a href="/blog/como-calcular-adicional-noturno/">Como Calcular Adicional Noturno Passo a Passo</a></h2>
          <p>Aprenda a encontrar o valor da hora normal, converter a hora noturna reduzida e aplicar o percentual com um exemplo completo.</p>
          <a class="text-link" href="/blog/como-calcular-adicional-noturno/">Leia mais →</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
