---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Blog | Adicional Noturno";
const description = "Espaço reservado para futuros conteúdos sobre adicional noturno.";
---

<BaseLayout title={title} description={description} canonicalPath="/blog/" noindex>
  <section class="page-hero empty-blog">
    <div class="reading-width">
      <h1>Blog</h1>
      <p>Novos conteúdos serão publicados em breve.</p>
    </div>
  </section>
</BaseLayout>
