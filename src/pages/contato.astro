---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const title = "Contato | Adicional Noturno";
const description =
  "Entre em contato com o site Adicional Noturno para enviar dúvidas, sugestões ou correções.";
---

<BaseLayout title={title} description={description} canonicalPath="/contato/">
  <section class="page-hero">
    <div class="reading-width">
      <h1>Contato</h1>
      <p>Envie dúvidas, sugestões de pauta ou correções sobre o site. Respondemos pelo e-mail informado no formulário.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="contact-layout container">
      <div>
        <h2>Fale conosco</h2>
        <p>Você também pode escrever diretamente para <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.</p>
        <h3>Quando entrar em contato</h3>
        <p>Use este canal para sugerir melhorias, comunicar erro de conteúdo, solicitar correção ou tirar dúvidas sobre o funcionamento do site. Para uma análise do seu caso trabalhista, procure o RH, o sindicato ou um profissional qualificado.</p>
        <h3>Privacidade da mensagem</h3>
        <p>Os dados do formulário são usados somente para responder ao contato. Consulte a <a href="/politica-de-privacidade/">Política de Privacidade</a> para entender como tratamos mensagens e inscrições.</p>
        <p>Não envie CPF, documentos, senhas, endereço ou cópia completa do holerite. O site não presta consultoria jurídica individual.</p>
      </div>
      <form id="contact-form" class="contact-form" aria-describedby="contact-status">
        <div class="field">
          <label for="contact-name">Nome</label>
          <input id="contact-name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="contact-email">E-mail</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="contact-subject">Assunto</label>
          <input id="contact-subject" name="subject" required />
        </div>
        <div class="field">
          <label for="contact-message">Mensagem</label>
          <textarea id="contact-message" name="message" rows="6" required></textarea>
        </div>
        <label class="check-row">
          <input type="checkbox" name="acknowledgment" required />
          <span>Confirmo que li o aviso acima e não incluí dados pessoais sensíveis.</span>
        </label>
        <input class="honeypot" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="button primary-button" type="submit">Enviar mensagem</button>
        <p id="contact-status" class="form-status" role="status" aria-live="polite">Os dados serão usados somente para responder à sua mensagem.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#contact-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !status) return;
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']")!;
    button.disabled = true;
    status.textContent = "Enviando sua mensagem...";
    const data = Object.fromEntries(new FormData(form));

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data)
      });
      const result = await response.json() as { message?: string };
      status.textContent = result.message || "Não foi possível enviar a mensagem.";
      if (response.ok) form.reset();
    } catch {
      status.textContent = "Não foi possível conectar. Tente novamente mais tarde.";
    } finally {
      button.disabled = false;
    }
  });
</script>
