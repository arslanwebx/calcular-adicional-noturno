---
import BaseLayout from "../layouts/BaseLayout.astro";
import Calculator from "../components/calculator/Calculator.astro";
import HomeContent from "../components/HomeContent.astro";
import JsonLd from "../components/JsonLd.astro";
import { siteConfig } from "../config/site";

const title = "Calcular Adicional Noturno: Calculadora Grátis";
const description =
  "Calcule o adicional noturno com salário, jornada, percentual e hora reduzida. Veja o resultado detalhado e entenda cada etapa.";

const faqs = [
  ["Qual é o percentual do adicional noturno?", "Na regra urbana geral da CLT, o adicional é de pelo menos 20% sobre a hora diurna. A convenção coletiva pode prever percentual maior."],
  ["O divisor mensal é sempre 220?", "Não. O divisor depende da jornada e do contrato. Use o valor adotado pela sua folha ou confirmado na convenção coletiva."],
  ["Como funciona a hora noturna reduzida?", "Na regra urbana geral, 52 minutos e 30 segundos são computados como uma hora noturna. Sete horas reais entre 22h e 5h correspondem a oito horas computadas."],
  ["Posso informar horas já convertidas?", "Sim. Se o ponto ou o holerite já mostra horas noturnas reduzidas, escolha essa opção para evitar aplicar a conversão duas vezes."],
  ["Quem trabalha depois das 5h recebe adicional?", "Pode receber quando houver prorrogação da jornada noturna. A jornada completa e a norma coletiva precisam ser conferidas antes de incluir essas horas."],
  ["Adicional noturno entra na hora extra?", "Uma hora extra noturna pode envolver as duas parcelas. A forma de composição depende da norma coletiva e do método usado pela folha."],
  ["Trabalhador rural usa a mesma regra?", "Não. A legislação rural prevê períodos noturnos e percentual próprios. Os padrões desta calculadora são urbanos."],
  ["A convenção coletiva pode aumentar o percentual?", "Sim. Acordos e convenções coletivas podem trazer condição mais favorável, inclusive percentual maior ou regra própria de apuração."],
  ["Como conferir o adicional no holerite?", "Compare salário-base, divisor, horas noturnas, percentual e rubricas de hora extra. O holerite, também chamado de contracheque, deve ser lido junto com o controle de ponto."]
];

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    url: `${siteConfig.url}/`,
    inLanguage: "pt-BR"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: `${siteConfig.url}/`,
    inLanguage: "pt-BR",
    dateModified: siteConfig.contentModified
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Calculadora de Adicional Noturno",
    applicationCategory: "FinanceApplication",
    operatingSystem: "Qualquer navegador moderno",
    url: `${siteConfig.url}/#calculadora`,
    description,
    offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
    inLanguage: "pt-BR"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer }
    }))
  }
];
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <JsonLd data={schemas} />
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>Calcular Adicional Noturno</h1>
        <p class="hero-lead">Informe o salário mensal, a jornada, o percentual aplicável e as horas trabalhadas à noite. A calculadora mostra o valor da hora normal, as horas noturnas consideradas e o adicional noturno estimado.</p>
        <p class="hero-privacy">O cálculo é feito neste navegador. Os dados informados não são enviados nem armazenados pelo site.</p>
        <a class="button primary-button" href="#calculadora">Ir para a calculadora</a>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <svg viewBox="0 0 420 280" width="420" height="280">
          <rect x="34" y="38" width="352" height="204" rx="24" fill="#fff"/>
          <rect x="58" y="62" width="138" height="18" rx="9" fill="#dbe8e6"/>
          <rect x="58" y="96" width="304" height="48" rx="10" fill="#f2f6f5"/>
          <rect x="58" y="160" width="140" height="54" rx="10" fill="#124e4a"/>
          <rect x="216" y="160" width="146" height="54" rx="10" fill="#e8b95b"/>
          <path d="M308 43a47 47 0 1 0 38 75 40 40 0 0 1-38-75Z" fill="#1a6460"/>
          <path d="m341 31 3 8 8 3-8 3-3 8-3-8-8-3 8-3 3-8Z" fill="#e8b95b"/>
        </svg>
      </div>
    </div>
  </section>
  <div class="container calculator-container">
    <Calculator />
  </div>
  <HomeContent />
</BaseLayout>
